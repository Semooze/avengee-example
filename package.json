{
  "name": "avengee-examples",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w @avengee/domain && npm run build -w @avengee/api",
    "dev": "npm run build:packages && next dev",
    "build": "npm run build:packages && next build --webpack",
    "start": "next start",
    "typecheck": "npm run build:packages && tsc --noEmit",
    "test": "npm run build:packages && node --test tests/api.test.cjs",
    "test:e2e": "playwright test",
    "test:production": "npm run build && node --test tests/build-smoke.cjs",
    "format:check": "prettier --check app components lib pages packages/*/src tests next.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@avengee/api": "*",
    "@avengee/domain": "*",
    "@libsql/client": "^0.18.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "light-my-request": "^6.8.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
